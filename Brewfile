# Run with: brew bundle --file=Brewfile
# Everything the designer needs. Nothing they don't.


# --- core ---
brew "git"
brew "gh"          # GitHub CLI. Handles login so we never touch SSH keys.
brew "node"        # JavaScript runtime. Astro needs it.
brew "pnpm"        # Package manager. Swap for npm by deleting this line.

# --- terminal comfort ---
brew "starship"                # the pretty prompt (folder, branch, dirty marker)
brew "zsh-autosuggestions"     # ghost text from history, Tab to accept
brew "zsh-syntax-highlighting" # green = valid command, red = typo
brew "eza"                     # nicer ls with icons
brew "zoxide"                  # cd that remembers where you've been
brew "micro"                   # a text editor that works like a normal app

# --- apps ---
cask "ghostty"
cask "zed"
cask "font-jetbrains-mono-nerd-font"  # needed for prompt icons
